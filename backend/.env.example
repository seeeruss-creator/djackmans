PORT=5000

# --- Local XAMPP MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=DJACKMAN_DB
DB_SSL=false

# --- Railway MySQL (paste from Railway → MySQL service → Variables) ---
# Option A: individual variables (recommended)
# MYSQLHOST=containers-us-west-xxx.railway.app
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=your_railway_password
# MYSQLDATABASE=railway
# DB_SSL=true
#
# Option B: connection URL
# MYSQL_URL=mysql://user:password@host:3306/railway
#
# Comment out local DB_* above when using Railway.

# For Netlify Postgres / Neon only (must start with postgresql://):
# DATABASE_URL=postgresql://...
# NETLIFY_DATABASE_URL=postgresql://...

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
